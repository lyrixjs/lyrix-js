{
  "name": "lyrix-js",
  "version": "0.1.3",
  "description": "Open source lyrics fetching and translation library.",
  "keywords": [
    "music",
    "lyrics",
    "translation"
  ],
  "homepage": "https://github.com/lyrixjs/lyrix-js#readme",
  "bugs": {
    "url": "https://github.com/lyrixjs/lyrix-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyrixjs/lyrix-js.git"
  },
  "license": "MIT",
  "author": "Debangshu Das",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "pnpm run clean && pnpm test",
    "format": "biome format --write src tests examples",
    "format:check": "biome format src tests examples",
    "lint": "biome lint src tests examples",
    "check": "biome check --write src tests examples",
    "test": "pnpm build && node --test tests/unit/*.test.mjs tests/metadata.test.mjs tests/lyrics.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.18.0",
  "dependencies": {
    "@syncfm/ttml": "^0.1.0",
    "lrclib-api": "^2.0.4",
    "musicbrainz-api": "^1.2.1",
    "openai": "^7.3.0"
  }
}
